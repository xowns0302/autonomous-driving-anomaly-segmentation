@startuml pipeline_activity
' UML 액티비티 다이어그램: 이미지 한 장의 처리 흐름 (C5 · C7 판단 포함)
skinparam defaultFontName NanumGothic
skinparam dpi 180
skinparam shadowing false
skinparam ArrowColor #14213D
skinparam activity {
  BackgroundColor #FFFFFC
  BorderColor #14213D
  DiamondBackgroundColor #FBE9DD
  DiamondBorderColor #C2410C
}

start
:입력 이미지;
fork
  :Grounding DINO 검출
  텍스트 = "objects" + Cityscapes 19개 class;
  :후보 box
  ID box (class 점수) / UN box (objectness);
fork again
  :Mask2Anomaly 픽셀 이상 점수 지도
  (C5, DetSeg-R에서 사용);
end fork

partition "IE-NMS (+ C5)" {
  :ID box 점수 > class별 bar 이면 점수 × 2;
  :모든 box를 점수 높은 순으로 정렬;
  repeat
    :다음 box 선택;
    if (더 높은 점수의 남은 box와 IoU ≥ 0.5?) then (예)
      if (C5: 지우는 쪽이 ID box이고\n지워지는 UN box 안 M2A 평균 ≥ 0.5?) then (예)
        :보호 (남김); <<#FBE9DD>>
      else (아니오)
        :삭제;
      endif
    else (아니오)
      :남김;
    endif
  repeat while (남은 box 있음?) is (예)
  ->아니오;
  :ID box는 모두 버림;
}

:objectness > 0.2 인 UN box만 남김
→ 이상 물체(OoD) box;

if (C8 사용? (C5 + C7)) then (예)
  :DINOv2 box 특징과 prototype 비교;
  if (prototype 거리 < 0.35?\n(아는 물체와 아주 닮음)) then (예)
    :해당 box 제거;
  else (아니오)
  endif
else (아니오)
endif

if (출력 방식) then (DetSeg-S)
  :SAM ViT-B
  box → 물체 mask;
  :이상 mask (threshold 없음)
  지표: IoU;
else (DetSeg-R)
  :M2A 점수 지도에서
  OoD box 안 점수 + 1.0;
  :이상 점수 지도
  지표: AP · FPR95 · IoU;
endif
stop
@enduml
