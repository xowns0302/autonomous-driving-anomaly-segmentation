// UML 액티비티 다이어그램 가로판 ① 입력·검출·강화 (세로 전체판: pipeline_activity.puml)
// 렌더: dot -Tpng -Gdpi=200 activity_row1.dot -o ../../assets/figures/activity_row1.png
digraph R1 {
  rankdir=LR; nodesep=0.25; ranksep=0.35; bgcolor="#FFFFFF"; pad=0.1;
  node [fontname="NanumGothic", fontsize=15, shape=box, style="rounded,filled", fillcolor="#FFFFFC", color="#14213D", penwidth=1.3, margin="0.12,0.08"];
  edge [fontname="NanumGothic", fontsize=14, color="#14213D", arrowsize=0.8, penwidth=1.3];
  start [shape=circle, label="", width=0.28, style=filled, fillcolor="#14213D"];
  img  [label="입력 이미지"];
  fork [shape=box, label="", width=0.07, height=1.3, style=filled, fillcolor="#14213D"];
  gd   [label="Grounding DINO 검출\n(objects + 19개 class)"];
  cand [label="후보 box\nID box / UN box"];
  m2a  [label="Mask2Anomaly\n픽셀 이상 점수 지도"];
  join [shape=box, label="", width=0.07, height=1.3, style=filled, fillcolor="#14213D"];
  boost [label="IE-NMS 시작:\n신뢰 기준선 넘은 ID box\n점수 × 2, 점수 순 정렬"];
  c1   [shape=circle, label="A", width=0.42, fixedsize=true];
  start -> img -> fork;
  fork -> gd -> cand -> join;
  fork -> m2a -> join;
  join -> boost -> c1;
}
